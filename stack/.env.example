# Your timezone, as in /usr/share/zoneinfo.
TZ=Etc/UTC

# Tapo camera account, not your TP-Link login.
# Tapo app > camera > Settings > Advanced Settings > Camera Account.
# Use letters and digits only; special characters break the RTSP URL.
FRIGATE_TAPO_IP=192.168.1.50
FRIGATE_TAPO_USER=change_me
FRIGATE_TAPO_PASSWORD=change_me

# The floor area to check, as fractions of the full camera frame: x1,y1,x2,y2.
# It is resized to a 640x640 square. Check it with POST /preview (docs/setup.md).
POTTY_CROP=0,0.24,1,1
